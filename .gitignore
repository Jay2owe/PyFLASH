*.py[cod]
*$py.class

.pytest_cache/
.mypy_cache/
.ruff_cache/
.tmp/
build/
dist/
*.egg-info/

*.tmp.*
*.bak

# Local analysis outputs and private data exports.
No Combo/
Exports/
Results/
*.xlsx
*.xls
*.pkl
*.pickle

# Local notebooks and agent handoff/context files can contain private paths.
example_notebook.ipynb
CONTEXT.md
HANDOFF.md
.claude/
.codex/

# Graphify knowledge graph artifacts are local/generated.
graphify-out/
.graphify_*.json
.graphify_python

# Agent/dev execution artifacts and internal step-plan folders (contain
# private absolute paths; not for public release).
.swarm_logs/
docs/plot-superplot/
docs/pyflash-ui/

# Local describe-layer run store. Dev scripts and docs can carry private
# absolute paths, so ignore those dirs wholesale rather than vetting each file
# (already-tracked files such as scripts/rebuild_graphify_ast.py and
# docs/plotting_function_context.md stay tracked). Keeps the public branch clean.
.runtime/
scripts/
!scripts/
scripts/*
!scripts/check_ui_workflow.py
!scripts/benchmark_ui_preparation.py
!scripts/check_ui_responsiveness.py
!scripts/check_ui_catalogue.py
!scripts/check_ui_function_workbench.py
!scripts/verify.py
!scripts/project_contract.py
!scripts/contracts-requirements.txt
!scripts/ui_readiness.py
!scripts/check_ui_real_data.py
!scripts/check_reproducibility_distribution.py
!scripts/check_dependency_repair.py
docs/
!docs/
docs/*
!docs/wiki/
!docs/wiki/**
# docs-site build inputs live directly under docs/ and must be tracked
!docs/requirements.txt
!docs/ui-workflow.md
!docs/ui-performance.md
!docs/ui-function-usability-plan.md
!docs/software-development-alignment.md
!docs/reproducibility-run.md
!docs/project-contracts.md
!docs/project-contracts-verification.json

# Reproducibility receipts are generated; adapters and frozen fixtures are public.
/reproducibility/results/
/research/
/demo/output*/
# Browser review screenshots and measurements are local generated artifacts.
/ui-review/
# ...but never commit compiled Python cruft inside the wiki examples
docs/wiki/**/__pycache__/
docs/wiki/**/*.pyc

# transient debug traces
tmp_*.txt

# MkDocs build output (docs site is built by Read the Docs / CI, not committed)
/site/

# Pytest scratch output roots (preview PNG/SVG/CSV written by test runs).
# Regenerated on every run; never an input.
.pytest-tmp*/

# Local recovery identity follows project moves; never publish local settings.
/.pyflash-workspace-id.json
/.pyflash-workspace-id.backup.json
